# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit a filled-in copy.
# The site runs correctly with every value below unset: the AI assistant falls
# back to deterministic grounded retrieval over the resume knowledge base.
# ---------------------------------------------------------------------------

# Public site URL — used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Which LLM the assistant should use.
#   anthropic | openai | local
# Unset = first configured provider wins; none configured = local.
AI_PROVIDER=anthropic

# Anthropic (server-side only — never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (server-side only — never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
