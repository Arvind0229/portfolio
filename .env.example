# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit a filled-in copy.
# The site runs correctly with every value below unset: the AI assistant falls
# back to deterministic grounded retrieval over the resume knowledge base.
# ---------------------------------------------------------------------------

# Public site URL — used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Which LLM the assistant should use.
#   anthropic | openai | local
# Unset = first configured provider wins; none configured = local.
AI_PROVIDER=anthropic

# Anthropic (server-side only — never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (server-side only — never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Admin panel (/admin)
# ---------------------------------------------------------------------------
# None of this is needed to run the site, and none of it is needed on your own
# laptop: `npm run dev` serves the admin page with no sign-in at all, because
# the port is not reachable from anywhere else. These variables only matter on
# the deployed site.
#
# Generate the first two with:  npm run admin:secret
# Set them in your host's environment settings (Vercel: Project → Settings →
# Environment Variables). Never commit a filled-in copy of this file.

# Base32 secret shared with your authenticator app. Without it, the live admin
# page refuses every sign-in rather than falling open.
ADMIN_TOTP_SECRET=

# Signs the session cookie. At least 32 characters. Changing it signs you out
# of every device immediately — which is the whole revocation mechanism.
ADMIN_SESSION_SECRET=

# Where a save from the live site is committed. Without these the admin page
# still opens and still refuses to save, and says why.
# The token is a fine-grained PAT scoped to this one repository, with
# Contents: Read and write — nothing else.
ADMIN_GITHUB_REPO=your-username/your-repo
ADMIN_GITHUB_TOKEN=
ADMIN_GITHUB_BRANCH=main
ADMIN_GITHUB_AUTHOR_NAME=Arvind Gupta
ADMIN_GITHUB_AUTHOR_EMAIL=you@users.noreply.github.com
